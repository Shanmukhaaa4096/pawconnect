{
  "name": "pawconnect",
  "version": "1.0.0",
  "type": "module",
  "description": "PawConnect - Modern Full-Stack Pet Adoption Platform",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "node server/src/index.js",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "node start-dev.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  }
}
